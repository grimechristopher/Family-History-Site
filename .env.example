# Postgres inside the self-hosted Supabase. Must use the container hostname on
# the supabase_default network: port 5432 is not exposed publicly, so the public
# hostname will not connect.
DATABASE_URL=postgres://postgres:PASSWORD@supabase-db:5432/postgres?sslmode=disable

SUPABASE_URL=https://supabase.example.com
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# OPTIONAL. With it, tokens are verified locally (no network call at sign-in).
# Without it, Supabase is asked to verify its own tokens, so the signing secret
# never has to leave the Supabase instance. It is the JWT_SECRET from the
# Supabase docker .env -- NOT the identically named one in Strapi's .env.
SUPABASE_JWT_SECRET=

# Leave blank until a real user token has been inspected. Self-hosted GoTrue
# usually issues "supabase"; hosted Supabase issues a URL. Verification is safe
# without it -- signature, role, and expiry are all still enforced.
SUPABASE_JWT_ISSUER=

BASE_URL=https://family.example.com

# Storage buckets. Both already exist in Supabase.
SUPABASE_PHOTO_BUCKET=family-questions-photos
SUPABASE_AUDIO_BUCKET=family-questions-audio
