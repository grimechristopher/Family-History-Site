# Postgres inside the self-hosted Supabase. Must use the container hostname on
# the supabase_default network: port 5432 is not exposed publicly, so the public
# hostname will not connect.
DATABASE_URL=postgres://postgres:PASSWORD@supabase-db:5432/postgres?sslmode=disable

SUPABASE_URL=https://supabase.example.com
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# OPTIONAL. With it, tokens are verified locally (no network call at sign-in).
# Without it, Supabase is asked to verify its own tokens, so the signing secret
# never has to leave the Supabase instance. It is the JWT_SECRET from the
# Supabase docker .env -- NOT the identically named one in Strapi's .env.
SUPABASE_JWT_SECRET=

# Leave blank until a real user token has been inspected. Self-hosted GoTrue
# usually issues "supabase"; hosted Supabase issues a URL. Verification is safe
# without it -- signature, role, and expiry are all still enforced.
SUPABASE_JWT_ISSUER=

BASE_URL=https://family.example.com

# Storage buckets. Both already exist in Supabase.
SUPABASE_PHOTO_BUCKET=family-questions-photos
SUPABASE_AUDIO_BUCKET=family-questions-audio

# Signs in as any contributor from /dev/login/{name}, with no magic link, so the
# site can be checked as Mom or Dad. This is an authentication bypass: set it only
# on a development machine, never in production.
# DEV_LOGIN=1

# Who the tree is built around, in GEDCOM form "Given /Surname/". The family's own
# names are configuration, not code, so this repository carries none of them.
DAD_GEDCOM_NAME="Given /Surname/"
MOM_GEDCOM_NAME="Given /Surname/"
# People to include who no ancestor walk reaches, such as a step-parent. Comma-separated.
EXTRA_GEDCOM_NAMES=
# How the admin is named on the site.
ADMIN_LABEL=Admin
# Your own data, kept outside the repository.
GEDCOM_PATH=/path/to/your-tree.ged
PROMPTS_PATH=/path/to/prompts.md

# The server must NOT connect as a superuser. Postgres exempts superusers from
# row-level security, so every family-isolation policy would be created, look
# correct, and do nothing. Migration 0005 creates the fhs_app role; once, by hand:
#   ALTER ROLE fhs_app PASSWORD '<something>';
#   REASSIGN OWNED BY postgres TO fhs_app;
# then point DATABASE_URL at fhs_app instead of postgres.
