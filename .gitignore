# Secrets — this repo will hold Supabase service_role and JWT secrets. Never commit them.
.env
.env.*
!.env.example

# Build output
/bin/
/tmp/
static/css/tailwind.css

# Local data. The family's own GEDCOM export stays out; the small invented one the
# parser is tested against has to be in, or those tests cannot run from a clone.
*.ged
!internal/gedcom/testdata/*.ged
*.dump

# Which lines to import, and who is asked what. Real names, addresses and
# family records. The example config is committed; the real one never is.
/lines.conf
/prompts/
/gedcom/
/tree/

# Notes about the family. The spec and the plan quote real questions and name
# real people, and none of that belongs in a code repository -- the answers live
# in Postgres and the family's details should stay with them. Kept on disk,
# stripped from history.
/docs/

# Database dumps: the family's answers and their photographs.
/backups/
